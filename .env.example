# Create a Sandbox REST app in the PayPal Developer Dashboard.
# Keep the secret in .env.local on this computer; never share it in chat.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_secret

# Optional: generated gemstone layouts still work without a key.
# Add your Gemini API key to the local .env.local file to refine colors and style text.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
